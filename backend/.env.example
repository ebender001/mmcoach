# Reference only -- Back4App does not read this file. Configure the same
# names under Back4App Dashboard > App Settings > Server Settings >
# Environment Variables, or export them locally if you build a local
# Parse Server for development.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# Optional -- see README "Back4App setup" for details.
PUBMED_API_KEY=
PUBMED_CONTACT_EMAIL=

# Required for mmAdminExportAICosts (the local AI-cost report tool in
# admin-tools/aiCostReport). Generate a random string and set the same
# value in that tool's own .env as MMCOACH_ADMIN_SECRET.
MMCOACH_ADMIN_SECRET=
